// RUN: %axc --emit-llvm-only %s -o %t 2>/dev/null
// RUN: %filecheck %s < %t.ll

fn inc{step int}(x int) int {
    return x + step
}

fn double(x int) int {
    return x * 2
}

fn main() int {
    let a int = 1->double
    let b int = inc{3}(a)
    let c int = inc(3, b)
    let d int = inc{3, c}()
    let e int = inc{}(3, d)
    return e
}

// CHECK: define i32 @inc(i32 %step, i32 %x)
// CHECK: define i32 @double(i32 %x)
// CHECK: call i32 @double(i32
// CHECK: call i32 @inc(i32 3, i32
// CHECK: call i32 @inc(i32 3, i32
// CHECK: call i32 @inc(i32 3, i32
