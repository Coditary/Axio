// RUN: %axc --emit-llvm-only %s -o %t 2>/dev/null
// RUN: %filecheck %s < %t.ll

fn pair(x int) (int, int) {
    return x, x + 1
}

fn main() int {
    let a int, b int = pair(4)
    return a + b
}

// CHECK: define { i32, i32 } @pair
// CHECK: insertvalue { i32, i32 }
// CHECK: extractvalue { i32, i32 }
