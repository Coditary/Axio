// RUN: %axc --emit-llvm-only %s -o %t 2>/dev/null
// RUN: %filecheck %s < %t.ll

class Obj {
    value int
}

fn make() Obj {
    let created Obj = new Obj(7)
    return created
}

fn main() int {
    let first Obj = make()
    let second Obj = first
    return first.value + second.value
}

// CHECK: call ptr @axio_arc_alloc
// CHECK: call ptr @make()
// CHECK: call ptr @axio_arc_retain
