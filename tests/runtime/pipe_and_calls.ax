// RUN: %axc %s -o %tbin
// RUN: %tbin; test "$?" = "14"

fn inc{step int}(x int) int {
    return x + step
}

fn double(x int) int {
    return x * 2
}

fn main() int {
    let a int = 1->double
    let b int = inc{3}(a)
    let c int = inc(3, b)
    let d int = inc{3, c}()
    let e int = inc{}(3, d)
    return e
}
