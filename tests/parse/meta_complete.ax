// RUN: %axc --dump-ast %s | %filecheck %s

#define APP Demo
#ifndef PROD
#define BUILD_MODE dev
#endif

@ThreadSafe
fn main() int {
    let text str = $readfile("../examples/assets/banner.txt")
    let api str = $generate_open_api("../showcase/full_language_demo/specs/openapi.axapi")
    let sql str = %%SQL{
SELECT * FROM users
}%%
    return 0
}

// CHECK: Preprocessor #define APP Demo
// CHECK: Preprocessor #ifndef PROD
// CHECK: Preprocessor #endif
// CHECK: Function main
// CHECK: CompileCall readfile
// CHECK: CompileCall generate_open_api
// CHECK: Dialect SQL
