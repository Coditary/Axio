// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn inc{step int}(x int) int {
    return x + step
}

fn double(x int) int {
    return x * 2
}

fn main() int {
    let a int = 1->double
    let b int = inc{3}(a)
    let c int = inc(3, b)
    let d int = inc{3, c}()
    let e int = inc{}(3, d)
    return e
}

// CHECK: Let a:int
// CHECK: Let b:int
// CHECK: Let c:int
// CHECK: Let d:int
// CHECK: Let e:int
// CHECK: Call

