// RUN: %axc --dump-ast %s | %filecheck %s

package main

class Obj {
    value int
}

fn consume(x *Obj) void {
    return
}

fn inspect(x ref Obj) void {
    return
}

fn keep(x Obj) void {
    return
}

fn main() int {
    let stack = Obj()
    let arc = new Obj()
    let weak = new weak Obj()
    let unique = *Obj()
    inspect(stack)
    keep(arc)
    consume(unique)
    return 0
}

