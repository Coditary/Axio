// RUN: %axc --dump-ast %s | %filecheck %s

struct Stats {
    speed int = 10
}

class Ship {
    Stats
    name str
    print str => "Hallo" + name

    fn greet() str {
        return print
    }
}

// CHECK: Class Ship
// CHECK: Member name:str
// CHECK: Member print:str
// CHECK: Function greet
