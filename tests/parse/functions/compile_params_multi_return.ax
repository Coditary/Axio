// RUN: %axc --dump-ast %s | %filecheck %s

fn project{scale int, bias int}(x int, y int) (int, int) {
    return x + scale, y + bias
}

fn main() int {
    let left int, right int = project{3}(4, 5)
    return left + right
}

// CHECK: Function project
// CHECK: CompileParam scale:int
// CHECK: CompileParam bias:int
// CHECK: Param x:int
// CHECK: Param y:int
// CHECK: Returns int int
// CHECK: Let left:int, right:int
