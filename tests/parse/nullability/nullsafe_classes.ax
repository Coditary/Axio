// RUN: %axc --dump-ast %s | %filecheck %s

class User {
    name str
    print str => "Hallo" + name

    fn greet() str {
        return print
    }
}

fn main() int {
    let ptr User = null
    if ptr? {
        ptr?.greet()
    }
    return 0
}

// CHECK: Class User
// CHECK: Member print:str
// CHECK: Unary
// CHECK: Call
