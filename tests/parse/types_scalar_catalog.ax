// RUN: %axc --dump-ast %s | %filecheck %s

fn main(
    a_i2 i2,
    a_i8 i8,
    a_i16 i16,
    a_i32 i32,
    a_i64 i64,
    a_u8 u8,
    a_u16 u16,
    a_u32 u32,
    a_u64 u64,
    a_bool bool,
    a_short short,
    a_int int,
    a_long long,
    a_double double,
    a_float float,
    a_f8 f8,
    a_f16 f16,
    a_f32 f32,
    a_f64 f64,
    a_char char,
    a_str str
) int {
    return 0
}

