// RUN: %axc --dump-ast %s | %filecheck %s

enum DistanceBand(label int, mult int) {
    Near(1, 1),
    Mid(2, 2),
    Far(3, 4),
}

fn main() int {
    if DistanceBand.Mid in DistanceBand.Far..DistanceBand.Near {
        return DistanceBand.Near.label
    }
    return DistanceBand(2).mult
}

// CHECK: Enum DistanceBand
// CHECK: Element Near
// CHECK: Element Mid
// CHECK: Element Far
// CHECK: Returns int
