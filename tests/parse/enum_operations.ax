// RUN: %axc --dump-ast %s | %filecheck %s

package main

enum ActorState as Flags {
    IsAlive,
    IsVisible,
}

fn main(state ActorState) int {
    let a ActorState = state set ActorState.IsAlive
    let b ActorState = a unset ActorState.IsVisible
    let c ActorState = b toggle ActorState.IsVisible
    if c is ActorState.IsAlive {
        return 1
    }
    if c isnot ActorState.IsVisible {
        return 2
    }
    return 0
}

// CHECK: Let a:ActorState
// CHECK: Let b:ActorState
// CHECK: Let c:ActorState
// CHECK: Binary

