// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a int = 8
    let b int = 1
    a >> b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:int
// CHECK-NEXT:       Int 8
// CHECK-NEXT:     Let b:int
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary ShiftRight
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
