// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a long = 8
    a >> 1
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:long
// CHECK-NEXT:       Int 8
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary ShiftRight
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Int 1
