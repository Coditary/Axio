// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u8 = 1
    a << 3
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u8
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary ShiftLeft
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Int 3
