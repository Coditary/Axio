// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value u8 = -8
    value >> 1
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:u8
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 8
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary ShiftRight
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Int 1
