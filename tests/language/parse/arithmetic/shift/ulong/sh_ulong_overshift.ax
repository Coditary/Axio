// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value ulong = 1
    value << 64
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:ulong
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary ShiftLeft
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Int 64
