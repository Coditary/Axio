// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value i64 = 9223372036854775807
    ~value
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:i64
// CHECK-NEXT:       Int 9223372036854775807
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary BitwiseNot
// CHECK-NEXT:         Ref value
