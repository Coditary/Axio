// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value ushort = 65535
    ~value
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:ushort
// CHECK-NEXT:       Int 65535
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary BitwiseNot
// CHECK-NEXT:         Ref value
