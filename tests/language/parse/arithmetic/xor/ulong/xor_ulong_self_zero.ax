// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value ulong = 6
    value ^ value
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:ulong
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitXor
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Ref value
