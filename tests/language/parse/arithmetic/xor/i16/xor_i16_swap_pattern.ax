// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i16 = 6
    let b i16 = 3
    a ^ b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i16
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     Let b:i16
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitXor
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
