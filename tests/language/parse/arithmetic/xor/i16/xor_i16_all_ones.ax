// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value i16 = 6
    value ^ -1
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:i16
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitXor
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Unary Negate
// CHECK-NEXT:           Int 1
