// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a char = 6
    a ^ 1
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:char
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitXor
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Int 1
