// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u8 = 9
    a % 4
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u8
// CHECK-NEXT:       Int 9
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Int 4
