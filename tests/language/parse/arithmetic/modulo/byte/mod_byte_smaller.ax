// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a byte = 3
    let b byte = 5
    a % b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:byte
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     Let b:byte
// CHECK-NEXT:       Int 5
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
