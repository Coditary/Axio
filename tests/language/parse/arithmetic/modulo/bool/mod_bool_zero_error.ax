// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a bool = 9
    let b bool = 0
    a % b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:bool
// CHECK-NEXT:       Int 9
// CHECK-NEXT:     Let b:bool
// CHECK-NEXT:       Int 0
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
