// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a ushort = 10
    let b ushort = 8
    a % b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:ushort
// CHECK-NEXT:       Int 10
// CHECK-NEXT:     Let b:ushort
// CHECK-NEXT:       Int 8
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
