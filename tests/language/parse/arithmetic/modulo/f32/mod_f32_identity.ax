// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f32 = 9.5
    a % a
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f32
// CHECK-NEXT:       Float 9.5
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref a
