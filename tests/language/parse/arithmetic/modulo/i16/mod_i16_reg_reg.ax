// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i16 = 9
    let b i16 = 4
    a % b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i16
// CHECK-NEXT:       Int 9
// CHECK-NEXT:     Let b:i16
// CHECK-NEXT:       Int 4
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
