// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f16 = -9.5
    let b f16 = 4.0
    a % b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f16
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Float 9.5
// CHECK-NEXT:     Let b:f16
// CHECK-NEXT:       Float 4
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
