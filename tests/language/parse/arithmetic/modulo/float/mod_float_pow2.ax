// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a float = 10.5
    let b float = 8.0
    a % b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:float
// CHECK-NEXT:       Float 10.5
// CHECK-NEXT:     Let b:float
// CHECK-NEXT:       Float 8
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
