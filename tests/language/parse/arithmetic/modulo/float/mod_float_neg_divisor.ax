// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a float = 9.5
    let b float = -4.0
    a % b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:float
// CHECK-NEXT:       Float 9.5
// CHECK-NEXT:     Let b:float
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Float 4
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mod
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
