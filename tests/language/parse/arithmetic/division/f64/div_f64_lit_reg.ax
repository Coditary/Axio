// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let b f64 = 2.0
    8.0 / b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let b:f64
// CHECK-NEXT:       Float 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Float 8
// CHECK-NEXT:         Ref b
