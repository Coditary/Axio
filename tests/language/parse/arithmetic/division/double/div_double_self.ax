// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a double = 8.0
    a / a
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:double
// CHECK-NEXT:       Float 8
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref a
