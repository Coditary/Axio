// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i16 = 7
    let b i16 = 2
    a / b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i16
// CHECK-NEXT:       Int 7
// CHECK-NEXT:     Let b:i16
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
