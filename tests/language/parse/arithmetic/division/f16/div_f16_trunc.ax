// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f16 = 7.0
    let b f16 = 2.0
    a / b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f16
// CHECK-NEXT:       Float 7
// CHECK-NEXT:     Let b:f16
// CHECK-NEXT:       Float 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
