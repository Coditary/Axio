// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a long = 8
    let b long = 0
    a / b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:long
// CHECK-NEXT:       Int 8
// CHECK-NEXT:     Let b:long
// CHECK-NEXT:       Int 0
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
