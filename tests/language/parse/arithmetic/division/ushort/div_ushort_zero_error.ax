// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a ushort = 8
    let b ushort = 0
    a / b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:ushort
// CHECK-NEXT:       Int 8
// CHECK-NEXT:     Let b:ushort
// CHECK-NEXT:       Int 0
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
