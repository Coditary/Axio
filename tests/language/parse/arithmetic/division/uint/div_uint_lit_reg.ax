// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let b uint = 2
    8 / b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let b:uint
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Int 8
// CHECK-NEXT:         Ref b
