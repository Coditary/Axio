// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a char = -128
    let b char = -1
    a / b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:char
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 128
// CHECK-NEXT:     Let b:char
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
