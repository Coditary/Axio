// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f32 = 8.0
    a / 2.0
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f32
// CHECK-NEXT:       Float 8
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Div
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Float 2
