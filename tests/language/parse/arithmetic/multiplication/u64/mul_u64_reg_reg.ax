// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u64 = 6
    let b u64 = 3
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u64
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     Let b:u64
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
