// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u16 = 65535
    let b u16 = 2
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u16
// CHECK-NEXT:       Int 65535
// CHECK-NEXT:     Let b:u16
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
