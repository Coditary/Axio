// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a char = 127
    let b char = 2
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:char
// CHECK-NEXT:       Int 127
// CHECK-NEXT:     Let b:char
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
