// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i2 = 1
    let b i2 = 2
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i2
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:i2
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
