// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a double = -6.0
    let b double = 3.0
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:double
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Float 6
// CHECK-NEXT:     Let b:double
// CHECK-NEXT:       Float 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
