// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f32 = 3.4028235e38
    let b f32 = 2.0
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f32
// CHECK-NEXT:       Float 3.40282e+38
// CHECK-NEXT:     Let b:f32
// CHECK-NEXT:       Float 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
