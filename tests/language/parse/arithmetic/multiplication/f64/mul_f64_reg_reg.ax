// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f64 = 6.0
    let b f64 = 3.0
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f64
// CHECK-NEXT:       Float 6
// CHECK-NEXT:     Let b:f64
// CHECK-NEXT:       Float 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
