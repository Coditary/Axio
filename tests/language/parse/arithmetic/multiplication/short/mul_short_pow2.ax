// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a short = 8
    a * 2
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:short
// CHECK-NEXT:       Int 8
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Int 2
