// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i32 = 2147483647
    let b i32 = 2
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i32
// CHECK-NEXT:       Int 2147483647
// CHECK-NEXT:     Let b:i32
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
