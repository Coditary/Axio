// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a ulong = 6
    a * 0
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:ulong
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Int 0
