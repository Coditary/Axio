// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a ulong = 18446744073709551615
    let b ulong = 2
    a * b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:ulong
// CHECK-NEXT:       Int 9223372036854775807
// CHECK-NEXT:     Let b:ulong
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Mul
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
