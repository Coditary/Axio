// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f8 = 3.0
    a - 1.0
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f8
// CHECK-NEXT:       Float 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Sub
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Float 1
