// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i8 = 1
    let b i8 = 3
    a - b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i8
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:i8
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Sub
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
