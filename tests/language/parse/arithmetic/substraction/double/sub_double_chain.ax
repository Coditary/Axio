// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a double = 5.0
    let b double = 3.0
    let c double = 1.0
    a - b - c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:double
// CHECK-NEXT:       Float 5
// CHECK-NEXT:     Let b:double
// CHECK-NEXT:       Float 3
// CHECK-NEXT:     Let c:double
// CHECK-NEXT:       Float 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Sub
// CHECK-NEXT:         Binary Sub
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
