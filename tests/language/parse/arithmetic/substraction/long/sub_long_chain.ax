// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a long = 5
    let b long = 3
    let c long = 1
    a - b - c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:long
// CHECK-NEXT:       Int 5
// CHECK-NEXT:     Let b:long
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     Let c:long
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Sub
// CHECK-NEXT:         Binary Sub
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
