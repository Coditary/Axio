// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f32 = 5.0
    let b f32 = 3.0
    let c f32 = 1.0
    a - b - c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f32
// CHECK-NEXT:       Float 5
// CHECK-NEXT:     Let b:f32
// CHECK-NEXT:       Float 3
// CHECK-NEXT:     Let c:f32
// CHECK-NEXT:       Float 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Sub
// CHECK-NEXT:         Binary Sub
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
