// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u32 = 3
    a - 1
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u32
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Sub
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Int 1
