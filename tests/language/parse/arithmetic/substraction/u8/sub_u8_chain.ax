// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u8 = 5
    let b u8 = 3
    let c u8 = 1
    a - b - c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u8
// CHECK-NEXT:       Int 5
// CHECK-NEXT:     Let b:u8
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     Let c:u8
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Sub
// CHECK-NEXT:         Binary Sub
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
