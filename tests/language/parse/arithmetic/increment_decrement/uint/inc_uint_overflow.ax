// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value uint = 4294967295
    value++
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:uint
// CHECK-NEXT:       Int 4294967295
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostIncrement
// CHECK-NEXT:         Ref value
