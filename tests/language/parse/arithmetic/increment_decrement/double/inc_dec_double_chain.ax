// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value double = 1.0
    ++value
    value--
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:double
// CHECK-NEXT:       Float 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PreIncrement
// CHECK-NEXT:         Ref value
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostDecrement
// CHECK-NEXT:         Ref value
