// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value double = 1.7976931348623157e308
    value++
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:double
// CHECK-NEXT:       Float 1.79769e+308
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostIncrement
// CHECK-NEXT:         Ref value
