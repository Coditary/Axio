// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value u16 = 0
    for let i int = 0; i < 3; i++ {
        value++
    }
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:u16
// CHECK-NEXT:       Int 0
// CHECK-NEXT:     For
// CHECK-NEXT:       Let i:int
// CHECK-NEXT:         Int 0
// CHECK-NEXT:       Binary Less
// CHECK-NEXT:         Ref i
// CHECK-NEXT:         Int 3
// CHECK-NEXT:       Unary PostIncrement
// CHECK-NEXT:         Ref i
// CHECK-NEXT:       Block
// CHECK-NEXT:         ExprStmt
// CHECK-NEXT:           Unary PostIncrement
// CHECK-NEXT:             Ref value
