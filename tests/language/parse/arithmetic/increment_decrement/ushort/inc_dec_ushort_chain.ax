// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value ushort = 1
    ++value
    value--
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:ushort
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PreIncrement
// CHECK-NEXT:         Ref value
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostDecrement
// CHECK-NEXT:         Ref value
