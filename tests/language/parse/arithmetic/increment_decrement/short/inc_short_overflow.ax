// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value short = 32767
    value++
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:short
// CHECK-NEXT:       Int 32767
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostIncrement
// CHECK-NEXT:         Ref value
