// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value short = -32768
    value--
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:short
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 32768
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostDecrement
// CHECK-NEXT:         Ref value
