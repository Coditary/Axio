// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value f16 = 65504.0
    value++
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:f16
// CHECK-NEXT:       Float 65504
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostIncrement
// CHECK-NEXT:         Ref value
