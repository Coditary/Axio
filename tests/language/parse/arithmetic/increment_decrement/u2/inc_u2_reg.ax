// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value u2 = 1
    value++
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:u2
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostIncrement
// CHECK-NEXT:         Ref value
