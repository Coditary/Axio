// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value long = -9223372036854775808
    value--
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:long
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 9223372036854775807
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostDecrement
// CHECK-NEXT:         Ref value
