// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value float = 1.0
    value--
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:float
// CHECK-NEXT:       Float 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostDecrement
// CHECK-NEXT:         Ref value
