// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value u8 = 255
    value++
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:u8
// CHECK-NEXT:       Int 255
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostIncrement
// CHECK-NEXT:         Ref value
