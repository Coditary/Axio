// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value char = -128
    value--
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:char
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 128
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostDecrement
// CHECK-NEXT:         Ref value
