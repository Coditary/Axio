// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value f32 = 1.0
    value++
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:f32
// CHECK-NEXT:       Float 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Unary PostIncrement
// CHECK-NEXT:         Ref value
