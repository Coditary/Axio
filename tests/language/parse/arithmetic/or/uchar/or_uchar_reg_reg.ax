// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a uchar = 6
    let b uchar = 1
    a | b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:uchar
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     Let b:uchar
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitOr
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
