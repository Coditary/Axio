// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value u64 = 6
    value | 0
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:u64
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitOr
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Int 0
