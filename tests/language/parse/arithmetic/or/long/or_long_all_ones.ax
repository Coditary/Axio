// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value long = 6
    value | -1
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:long
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitOr
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Unary Negate
// CHECK-NEXT:           Int 1
