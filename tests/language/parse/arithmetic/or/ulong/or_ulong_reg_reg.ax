// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a ulong = 6
    let b ulong = 1
    a | b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:ulong
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     Let b:ulong
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitOr
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
