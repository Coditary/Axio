// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value short = 6
    value & 0
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:short
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitAnd
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Int 0
