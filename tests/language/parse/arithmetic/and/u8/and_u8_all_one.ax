// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value u8 = 6
    value & 255
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:u8
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitAnd
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Int 255
