// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value ulong = 6
    value & 18446744073709551615
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:ulong
// CHECK-NEXT:       Int 6
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitAnd
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Int 9223372036854775807
