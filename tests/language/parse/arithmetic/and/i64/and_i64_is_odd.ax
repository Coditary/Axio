// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let value i64 = 7
    value & 1
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let value:i64
// CHECK-NEXT:       Int 7
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary BitAnd
// CHECK-NEXT:         Ref value
// CHECK-NEXT:         Int 1
