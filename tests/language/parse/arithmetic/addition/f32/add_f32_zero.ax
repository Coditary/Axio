// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a f32 = 0.0
    let b f32 = 0.0
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:f32
// CHECK-NEXT:       Float 0
// CHECK-NEXT:     Let b:f32
// CHECK-NEXT:       Float 0
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
