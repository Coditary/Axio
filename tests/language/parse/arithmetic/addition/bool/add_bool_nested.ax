// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a bool = 1
    let b bool = 2
    let c bool = 3
    a + (b + c)
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:bool
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:bool
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:bool
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref b
// CHECK-NEXT:           Ref c
