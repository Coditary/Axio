// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a long = 1
    let b long = 2
    let c long = 3
    a + b + c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:long
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:long
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:long
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
