// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i64 = 9223372036854775807
    let b i64 = 1
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i64
// CHECK-NEXT:       Int 9223372036854775807
// CHECK-NEXT:     Let b:i64
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
