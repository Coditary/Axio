// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i16 = -32768
    let b i16 = -1
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i16
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 32768
// CHECK-NEXT:     Let b:i16
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
