// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u16 = 1
    let b u16 = 2
    let c u16 = 3
    a + b + c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u16
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:u16
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:u16
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
