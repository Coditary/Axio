// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i8 = -128
    let b i8 = -1
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i8
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 128
// CHECK-NEXT:     Let b:i8
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
