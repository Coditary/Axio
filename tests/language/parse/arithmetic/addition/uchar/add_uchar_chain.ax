// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a uchar = 1
    let b uchar = 2
    let c uchar = 3
    a + b + c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:uchar
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:uchar
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:uchar
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
