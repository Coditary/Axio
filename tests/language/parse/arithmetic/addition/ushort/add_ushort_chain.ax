// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a ushort = 1
    let b ushort = 2
    let c ushort = 3
    a + b + c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:ushort
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:ushort
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:ushort
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
