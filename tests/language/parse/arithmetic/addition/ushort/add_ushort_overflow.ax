// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a ushort = 65535
    let b ushort = 1
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:ushort
// CHECK-NEXT:       Int 65535
// CHECK-NEXT:     Let b:ushort
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
