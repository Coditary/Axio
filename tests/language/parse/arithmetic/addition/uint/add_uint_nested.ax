// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a uint = 1
    let b uint = 2
    let c uint = 3
    a + (b + c)
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:uint
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:uint
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:uint
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref b
// CHECK-NEXT:           Ref c
