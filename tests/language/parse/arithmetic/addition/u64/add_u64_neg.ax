// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u64 = 1
    let b u64 = -1
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u64
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:u64
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
