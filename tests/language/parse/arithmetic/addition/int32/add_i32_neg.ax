// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a i32 = 1
    let b i32 = -1
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:i32
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:i32
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
