// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a char = 1
    let b char = 2
    let c char = 3
    a + (b + c)
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:char
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:char
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:char
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref b
// CHECK-NEXT:           Ref c
