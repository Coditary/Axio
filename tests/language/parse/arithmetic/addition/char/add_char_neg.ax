// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a char = 1
    let b char = -1
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:char
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:char
// CHECK-NEXT:       Unary Negate
// CHECK-NEXT:         Int 1
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
