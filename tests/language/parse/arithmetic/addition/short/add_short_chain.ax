// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a short = 1
    let b short = 2
    let c short = 3
    a + b + c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:short
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:short
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:short
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
