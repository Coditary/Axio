// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a ulong = 1
    let b ulong = 2
    let c ulong = 3
    a + b + c
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:ulong
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:ulong
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     Let c:ulong
// CHECK-NEXT:       Int 3
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Binary Add
// CHECK-NEXT:           Ref a
// CHECK-NEXT:           Ref b
// CHECK-NEXT:         Ref c
