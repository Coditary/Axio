// RUN: %axc --dump-ast %s | %filecheck %s

package main

fn main() {
    let a u32 = 1
    let b u32 = 2
    a + b
}


// CHECK: Function main
// CHECK-NEXT:   Returns void
// CHECK-NEXT:   Block
// CHECK-NEXT:     Let a:u32
// CHECK-NEXT:       Int 1
// CHECK-NEXT:     Let b:u32
// CHECK-NEXT:       Int 2
// CHECK-NEXT:     ExprStmt
// CHECK-NEXT:       Binary Add
// CHECK-NEXT:         Ref a
// CHECK-NEXT:         Ref b
