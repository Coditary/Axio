// RUN: %axc --check-only %s 2>&1 | %filecheck %s

class Obj {
    value int
}

fn keep(x Obj, w weak Obj, u *Obj) void {
    return
}

fn main() int {
    let arc = new Obj()
    let weak_ref = new weak Obj()
    let unique = *Obj()
    keep(arc, weak_ref, unique)
    return 0
}

