// RUN: %axc --check-only %s 2>&1 | %filecheck %s

package main

fn log{level int}(value int) int {
    return value
}

fn main() int {
    let a int = log{3}(1)
    let b int = log(4, a)
    let c int = log{5, b}()
    let d int = log{}(6, c)
    return d
}

// CHECK-NOT: error:
// CHECK-NOT: warning:

